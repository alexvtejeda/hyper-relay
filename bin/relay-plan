#!/bin/sh
# relay-plan: the command the orchestrator asks about a plan instead of reading it,
# and the keeper of each plan's run folder and its gates.log.
# POSIX shell, run by dash. How to use it: docs/relay-plan.md in hyper-relay.
#
#   relay-plan run-dir <plan>                      the plan's run folder, made
#   relay-plan check <plan> [--spec <spec>] [--sibling <plan>]... [--base <plan>]
#   relay-plan overlap <plan> <other>...           paths shared with other plans
#   relay-plan steps <plan> [reviewer|owner|after-merge|skill-test]
#   relay-plan step <plan> <id>                    one acceptance step's text
#   relay-plan scenarios <plan> <dir>              the skill-test situations, as files
#   relay-plan gate <plan> <command>               run a gate, log its block
#   relay-plan gates <plan> [<command>...]         each gate's latest block, judged
#
# Exit: 0 all ok; 1 a check failed or nothing was found; 2 a usage error or a missing file.
# Not set -e: gate outlives its command's failure, and each step checks its own status.
set -u
LC_ALL=C
export LC_ALL

USAGE="usage: relay-plan run-dir|check|overlap|steps|step|scenarios|gate|gates <plan> ... (docs/relay-plan.md)"
RUN_DIR_NAME=.hyper-relay/runs/

TMP=$(mktemp -d) || exit 2
trap 'rm -rf "$TMP"' EXIT INT TERM

die() { printf 'relay-plan: %s\n' "$*" >&2; exit 2; }
usage_error() { printf 'relay-plan: %s\n%s\n' "$*" "$USAGE" >&2; exit 2; }

# abs_path <path>: a relative path is under TOP, an absolute one is unchanged.
abs_path() {
    case $1 in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s/%s\n' "$TOP" "$1" ;;
    esac
}

# rel_path <path>: an absolute path under TOP without "$TOP/", a relative one unchanged.
rel_path() {
    case $1 in
        "$TOP"/*) printf '%s\n' "${1#"$TOP"/}" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# need_file <path>: exit 2 unless it is a file.
need_file() {
    [ -f "$(abs_path "$1")" ] || die "no such file: $1"
}

# branch_of <path>: the file name without its YYYY-MM-DD- prefix and .md, each only when present.
branch_of() {
    basename "$1" .md | sed 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}-//'
}

# ensure_run_dir <branch>: makes the run folder in the main checkout, and git-ignores
# .hyper-relay/runs/ there when it is not ignored. Prints the folder, no trailing /.
ensure_run_dir() {
    git -C "$MAIN" check-ignore -q "$RUN_DIR_NAME"
    case $? in
        0) ;;
        1)
            exclude=$(git -C "$MAIN" rev-parse --path-format=absolute --git-path info/exclude) ||
                die "cannot find the exclude file"
            mkdir -p "$(dirname "$exclude")" || die "cannot make the exclude file's folder"
            if [ -s "$exclude" ] && [ -n "$(tail -c 1 "$exclude")" ]; then
                printf '\n' >> "$exclude" || die "cannot write $exclude"
            fi
            printf '%s\n' "$RUN_DIR_NAME" >> "$exclude" || die "cannot write $exclude"
            ;;
        *) die "git check-ignore failed in $MAIN" ;;
    esac
    mkdir -p "$MAIN/.hyper-relay/runs/$1" || die "cannot make the run folder for $1"
    printf '%s\n' "$MAIN/.hyper-relay/runs/$1"
}

cmd_run_dir() {
    [ $# -eq 1 ] || usage_error "run-dir takes a plan"
    need_file "$1"
    ensure_run_dir "$(branch_of "$1")"
}

cmd_gate() {
    [ $# -eq 2 ] || usage_error "gate takes a plan and a command"
    need_file "$1"
    command_text=$2
    case $command_text in
        *'
'*) die "a gate command cannot hold a newline" ;;
    esac
    dir=$(ensure_run_dir "$(branch_of "$1")") || exit $?
    sha=$(git -C "$TOP" rev-parse HEAD) || die "no HEAD in $TOP"
    (cd "$TOP" && sh -c "$command_text" < /dev/null > "$TMP/gate.out" 2>&1)
    code=$?
    if [ -s "$TMP/gate.out" ] && [ -n "$(tail -c 1 "$TMP/gate.out")" ]; then
        printf '\n' >> "$TMP/gate.out"
    fi
    {
        printf 'GATE %s %s\n' "$sha" "$command_text"
        cat "$TMP/gate.out"
        printf 'EXIT %s\n' "$code"
    } >> "$dir/gates.log" || die "cannot write $dir/gates.log"
    tail -n 5 "$TMP/gate.out"
    printf 'EXIT %s\n' "$code"
    exit "$code"
}

cmd_gates() {
    [ $# -ge 1 ] || usage_error "gates takes a plan"
    need_file "$1"
    branch=$(branch_of "$1")
    shift
    tip=$(git -C "$TOP" rev-parse -q --verify "refs/heads/$branch") || die "no branch $branch"
    log="$MAIN/.hyper-relay/runs/$branch/gates.log"
    [ -f "$log" ] || die "no gates.log for $branch"
    : > "$TMP/named"
    for c in "$@"; do printf '%s\n' "$c" >> "$TMP/named"; done
    awk -v tip="$tip" -v named="$TMP/named" -v logf="$log" '
        BEGIN {
            while ((getline l < named) > 0) want[++nw] = l
            fail = 0
        }
        !inb && /^GATE [0-9a-f]+ / {
            sha = $2
            cmd = substr($0, 6 + length(sha) + 1)
            inb = 1; last = ""; next
        }
        inb && /^EXIT [0-9]+$/ {
            if (!(cmd in seen)) { seen[cmd] = 1; order[++no] = cmd }
            lsha[cmd] = sha; lexit[cmd] = $2; llast[cmd] = last
            inb = 0; nb++; next
        }
        inb && $0 != "" { last = $0 }
        END {
            if (nw == 0 && nb == 0) { print "relay-plan: no gate in " logf > "/dev/stderr"; exit 1 }
            n = nw ? nw : no
            for (i = 1; i <= n; i++) {
                c = nw ? want[i] : order[i]
                if (!(c in seen)) { print "FAIL " c ": not in gates.log"; fail = 1; continue }
                state = (lexit[c] == 0 && lsha[c] == tip) ? "ok" : "FAIL"
                if (state == "FAIL") fail = 1
                print state " " c ": exit " lexit[c] " at " substr(lsha[c], 1, 7) ": " (llast[c] == "" ? "(no output)" : llast[c])
            }
            exit fail
        }' "$log"
}

# scan <file>: one record per line of <file>, tab-separated: line number, kind (prose,
# open:<info>, code:<info>, close:<info>), task, step, then the line unchanged (so a tab in
# it survives). A fence opens, outside a fence, on a line of at least three backticks or
# tildes after optional blanks (a backtick line whose info holds a backtick is not one), and
# closes on a line of the same character, at least as many, then only blanks. Fences do not
# nest. A task is a "### Task <N>" heading outside a fence, to the next "## " or "### "
# heading outside one; a step is a "- [ ] **Step <id>" line, to the next step or the task's end.
scan() {
    awk '
    function trim(s) { sub(/^[ \t]+/, "", s); return s }
    BEGIN { OFS = "\t"; fch = ""; flen = 0; finfo = ""; task = 0; step = 0 }
    {
        line = $0; kind = "prose"
        t = trim(line); c = substr(t, 1, 1)
        if (fch != "") {
            kind = "code:" finfo
            if (c == fch) {
                n = 0
                while (substr(t, n + 1, 1) == fch) n++
                if (n >= flen && substr(t, n + 1) ~ /^[ \t]*$/) { kind = "close:" finfo; fch = "" }
            }
        } else if (c == "`" || c == "~") {
            n = 0
            while (substr(t, n + 1, 1) == c) n++
            rest = substr(t, n + 1)
            if (n >= 3 && !(c == "`" && index(rest, "`") > 0)) {
                info = trim(rest); sub(/[ \t].*$/, "", info)
                fch = c; flen = n; finfo = info; kind = "open:" info
            }
        }
        if (kind == "prose") {
            if (line ~ /^### Task [0-9]+/) {
                s = line; sub(/^### Task /, "", s); sub(/[^0-9].*$/, "", s); task = s; step = 0
            } else if (line ~ /^(##|###) /) {
                task = 0; step = 0
            } else if (task > 0 && line ~ /^- \[[ x]\] \*\*Step /) {
                s = line; sub(/^- \[[ x]\] \*\*Step /, "", s); sub(/[ *(:].*$/, "", s); step = s
            }
        }
        print NR, kind, task, step, line
    }' "$1"
}

# task_summary <file>: "<count> <last task number>", "0 0" with no task.
task_summary() {
    scan "$1" | awk -F'\t' '
        $2 == "prose" && $5 ~ /^### Task [0-9]+/ { n++; last = $3 }
        END { print n + 0, last + 0 }'
}

# acceptance_steps <file>: <id>, tab, <who>, tab, <title> for each step of the last task.
# The who is the first inline-code span in the parenthesis after "**Step <id>", "?" when
# there is none; the title runs from the first "): " to the next "**", a wrapped line joined
# with one space.
acceptance_steps() {
    scan "$1" | awk -F'\t' '
    function trim(s) { sub(/^[ \t]+/, "", s); return s }
    {
        k[NR] = $2; tk[NR] = $3; st[NR] = $4
        t = $0
        for (q = 0; q < 4; q++) sub(/^[^\t]*\t/, "", t)
        tx[NR] = t
        if ($2 == "prose" && t ~ /^### Task [0-9]+/) m = $3
    }
    END {
        for (i = 1; i <= NR; i++) {
            if (k[i] != "prose" || tk[i] != m || tx[i] !~ /^- \[[ x]\] \*\*Step /) continue
            acc = tx[i]; j = i
            while (index(substr(acc, index(acc, "**Step") + 6), "**") == 0 && j < NR &&
                   k[j + 1] == "prose" && tk[j + 1] == m && st[j + 1] == st[i] && tx[j + 1] !~ /^[ \t]*$/) {
                j++; acc = acc " " trim(tx[j])
            }
            body = substr(acc, index(acc, "**Step ") + 7)
            rest = substr(body, length(st[i]) + 1)
            who = "?"
            if (rest ~ /^ \(/) {
                p = index(rest, "): ")
                par = p ? substr(rest, 1, p) : rest
                b1 = index(par, "`")
                if (b1) { r2 = substr(par, b1 + 1); b2 = index(r2, "`"); if (b2) who = substr(r2, 1, b2 - 1) }
                title = p ? substr(rest, p + 3) : ""
            } else {
                title = rest; sub(/^[: \t]+/, "", title)
            }
            e = index(title, "**"); if (e) title = substr(title, 1, e - 1)
            print st[i] "\t" who "\t" title
        }
    }'
}

# step_text <file> <id>: the lines of the last task's step <id>, trailing blank lines
# dropped. Returns 1 when there is no such step.
step_text() {
    scan "$1" | awk -F'\t' -v id="$2" '
    {
        t = $0
        for (q = 0; q < 4; q++) sub(/^[^\t]*\t/, "", t)
        tx[NR] = t; tk[NR] = $3; st[NR] = $4
        if ($2 == "prose" && t ~ /^### Task [0-9]+/) m = $3
    }
    END {
        for (i = 1; i <= NR; i++) if (tk[i] == m && st[i] == id) {
            if (tx[i] == "" || tx[i] ~ /^[ \t]*$/) { held = held tx[i] "\n"; continue }
            printf "%s", held; held = ""
            print tx[i]; found = 1
        }
        exit found ? 0 : 1
    }'
}

cmd_steps() {
    [ $# -ge 1 ] && [ $# -le 2 ] || usage_error "steps takes a plan and optionally a who"
    need_file "$1"
    who=
    if [ $# -eq 2 ]; then
        case $2 in
            reviewer | owner | skill-test) who=$2 ;;
            after-merge) who='after merge' ;;
            *) usage_error "unknown who: $2" ;;
        esac
    fi
    file=$(abs_path "$1")
    summary=$(task_summary "$file")
    [ "$summary" != "0 0" ] || exit 1
    printf 'tasks %s; acceptance task %s\n' "${summary% *}" "${summary#* }"
    acceptance_steps "$file" > "$TMP/steps"
    if [ -n "$who" ]; then
        awk -F'\t' -v who="$who" '$2 == who' "$TMP/steps" > "$TMP/steps.w"
        mv "$TMP/steps.w" "$TMP/steps"
    fi
    [ -s "$TMP/steps" ] || exit 1
    cat "$TMP/steps"
}

cmd_step() {
    [ $# -eq 2 ] || usage_error "step takes a plan and a step id"
    need_file "$1"
    step_text "$(abs_path "$1")" "$2"
}

# situation <file> <id> <out>: writes the first fenced block after the step's "Situation:"
# label, without its fence lines, to <out>. Returns 1 when there is none.
situation() {
    scan "$1" | awk -F'\t' -v id="$2" -v out="$3" '
    {
        t = $0
        for (q = 0; q < 4; q++) sub(/^[^\t]*\t/, "", t)
        tx[NR] = t; k[NR] = $2; tk[NR] = $3; st[NR] = $4
        if ($2 == "prose" && t ~ /^### Task [0-9]+/) m = $3
    }
    END {
        for (i = 1; i <= NR; i++) {
            if (tk[i] != m || st[i] != id) continue
            if (!lab && k[i] == "prose" && tx[i] ~ /^(\*\*)?Situation:/) { lab = 1; continue }
            if (lab && !inf && k[i] ~ /^open:/) { inf = 1; printf "" > out; continue }
            if (inf && k[i] ~ /^code:/) { print tx[i] > out; continue }
            if (inf && k[i] ~ /^close:/) { done = 1; break }
        }
        if (inf) close(out)
        exit done ? 0 : 1
    }'
}

cmd_scenarios() {
    [ $# -eq 2 ] || usage_error "scenarios takes a plan and a folder"
    need_file "$1"
    file=$(abs_path "$1")
    dir=$2
    mkdir -p "$dir" || die "cannot make $dir"
    acceptance_steps "$file" | awk -F'\t' '$2 == "skill-test"' > "$TMP/skill"
    if [ ! -s "$TMP/skill" ]; then
        printf 'relay-plan: no skill-test step in %s\n' "$1" >&2
        exit 1
    fi
    rc=0
    while IFS="$(printf '\t')" read -r id who title; do
        if situation "$file" "$id" "$dir/step-$id.txt"; then
            printf '%s\t%s\t%s\n' "$id" "$dir/step-$id.txt" "$title"
        else
            rm -f "$dir/step-$id.txt"
            printf 'FAIL %s: no fenced situation\n' "$id"
            rc=1
        fi
    done < "$TMP/skill"
    exit "$rc"
}

[ $# -ge 1 ] || usage_error "no command"
COMMAND=$1
shift
case $COMMAND in
    run-dir | check | overlap | steps | step | scenarios | gate | gates) ;;
    *) usage_error "unknown command: $COMMAND" ;;
esac

TOP=$(git rev-parse --show-toplevel 2> /dev/null) || die "not inside a git repository"
common=$(git rev-parse --path-format=absolute --git-common-dir) || die "not inside a git repository"
MAIN=$(dirname "$common")

case $COMMAND in
    run-dir) cmd_run_dir "$@" ;;
    gate) cmd_gate "$@" ;;
    gates) cmd_gates "$@" ;;
    steps) cmd_steps "$@" ;;
    step) cmd_step "$@" ;;
    scenarios) cmd_scenarios "$@" ;;
    *) die "$COMMAND is not built yet" ;;
esac
